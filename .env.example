# Where sends go. The service itself has no default for this, so a run that
# forgets it stops instead of reaching the real gateway; docker compose falls
# back to the stand-in provider it starts, which is the value shown here.
# Name https://rest.messagebird.com only together with a real key below.
MESSAGEBIRD_BASE_URL=http://fake-messagebird:8099

# Leave blank for the stand-in provider: docker compose gives it and the
# service the same local key, so the two cannot disagree.
MESSAGEBIRD_ACCESS_KEY=
MESSAGEBIRD_ORIGINATOR=ACME

# Overrides the local development password. docker compose passes it to both
# PostgreSQL and the service, so the two cannot drift apart.
POSTGRES_PASSWORD=

# The service reads its database connection as discrete parameters, each with a
# default aimed at the local compose stack. docker compose sets DB_HOST and
# DB_PASSWORD for you; override the rest only when pointing somewhere else.
#
#   DB_HOST     localhost
#   DB_PORT     5432
#   DB_USER     notifications
#   DB_PASSWORD notifications
#   DB_NAME     notifications
#   DB_SSLMODE  disable
